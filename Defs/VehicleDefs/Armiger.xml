	<!--============BUILDABLE============-->
	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>LIK_ArmigerBlueprint</defName>
		<label>Armiger Knight</label>
		<description>The smallest of the Knight engines: a fast, lightly armoured walker with two arm-mounted autocannons and a carapace heavy stubber. Piloted from a throne in the carapace.</description>
		<graphicData>
			<texPath>Things/Knights/Armiger/Icon/armiger</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(5.530,5.530)</drawSize>
		</graphicData>
		<size>(4,4)</size>
		<statBases>
			<MaxHitPoints>2000</MaxHitPoints>
			<WorkToBuild>120000</WorkToBuild>
			<Flammability>0.1</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>LIK_ArmigerKnights</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<costList>
			<Steel>1200</Steel>
			<Plasteel>300</Plasteel>
			<ComponentIndustrial>30</ComponentIndustrial>
			<ComponentSpacer>12</ComponentSpacer>
		</costList>
		<designationCategory Inherit="False" />
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<soundBuilt/>
		<thingToSpawn>LIK_Armiger</thingToSpawn>
	</Vehicles.VehicleBuildDef>

