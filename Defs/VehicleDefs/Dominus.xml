	<!--============BUILDABLE============-->
	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>LIK_DominusBlueprint</defName>
		<label>Dominus Knight</label>
		<description>A siege-class engine. The Castellan pattern carries a plasma decimator and a Titan-killing volcano lance; the Valiant a conflagration cannon and a thundercoil harpoon. Shieldbreaker missiles and twin siegebreaker cannons ride its carapace, twin meltaguns flank its head. Piloted by a single noble through the Throne Mechanicum.</description>
		<graphicData>
			<texPath>Things/Knights/Dominus/Icon/dominus</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(9.790,9.790)</drawSize>
		</graphicData>
		<size>(7,7)</size>
		<statBases>
			<MaxHitPoints>7000</MaxHitPoints>
			<WorkToBuild>600000</WorkToBuild>
			<Flammability>0.1</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>LIK_DominusKnights</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>12</constructionSkillPrerequisite>
		<costList>
			<Steel>4500</Steel>
			<Plasteel>1500</Plasteel>
			<ComponentIndustrial>120</ComponentIndustrial>
			<ComponentSpacer>60</ComponentSpacer>
			<Gold>150</Gold>
		</costList>
		<designationCategory Inherit="False" />
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<soundBuilt/>
		<thingToSpawn>LIK_Dominus</thingToSpawn>
	</Vehicles.VehicleBuildDef>

