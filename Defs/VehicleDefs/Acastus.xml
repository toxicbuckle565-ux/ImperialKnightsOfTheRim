<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--============BUILDABLE============-->
	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>LIK_AcastusBlueprint</defName>
		<label>Acastus Knight</label>
		<description>A slow, towering fire-support engine (Porphyrion) carrying the heaviest guns of any Knight, built to break fortresses. Piloted by a single noble through the Throne Mechanicum.</description>
		<graphicData>
			<texPath>Things/Knights/Acastus/Icon/acastus</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(14.950,14.950)</drawSize>
		</graphicData>
		<size>(8,8)</size>
		<statBases>
			<MaxHitPoints>9500</MaxHitPoints>
			<WorkToBuild>720000</WorkToBuild>
			<Flammability>0.1</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>LIK_AcastusKnights</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>13</constructionSkillPrerequisite>
		<costList>
			<Steel>5500</Steel>
			<Plasteel>1900</Plasteel>
			<ComponentIndustrial>150</ComponentIndustrial>
			<ComponentSpacer>80</ComponentSpacer>
			<Gold>220</Gold>
		</costList>
		<designationCategory Inherit="False" />
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<soundBuilt/>
		<thingToSpawn>LIK_Acastus</thingToSpawn>
	</Vehicles.VehicleBuildDef>

	<!--==============PAWN===============-->
	<Vehicles.VehicleDef ParentName="BaseVehiclePawn">
		<defName>LIK_Acastus</defName>
		<label>Acastus Knight</label>
		<description>A slow, towering fire-support engine (Porphyrion) carrying the heaviest guns of any Knight, built to break fortresses. Piloted by a single noble through the Throne Mechanicum.</description>
		<graphicData>
			<texPath>Things/Knights/Acastus/acastus</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawSize>(14.950,14.950)</drawSize>
			<shaderType>CutoutComplexRGB</shaderType>
			<color>(84,126,188)</color>
			<colorTwo>(216,191,134)</colorTwo>
			<colorThree>(255,255,255)</colorThree>
		</graphicData>
		<uiIconPath>Things/Knights/Acastus/Icon/acastus_south</uiIconPath>
		<fillPercent>0.75</fillPercent>
		<altitudeLayer>PawnState</altitudeLayer>
		<buildDef>LIK_AcastusBlueprint</buildDef>
		<size>(8,8)</size>

		<navigationCategory>Manual</navigationCategory>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
		<nameable>true</nameable>

		<modExtensions>
			<li Class="LIK.DefModExtension_KnightToll">
				<strainPerHour>0.010</strainPerHour>
				<ageDaysPerHour>0.15</ageDaysPerHour>
				<feedbackScale>0.80</feedbackScale>
				<referenceSize>4</referenceSize>
				<minPiloting>14</minPiloting>
			</li>
			<!-- footsteps + war horn (Source/KnightSound.cs; sounds from Tools/gen_knight_sounds.py) -->
			<li Class="LIK.DefModExtension_KnightSound">
				<step>LIK_Snd_step_Acastus</step>
				<stepTicks>52</stepTicks>
				<stepShake>0.90</stepShake>
				<horn>LIK_Snd_horn_Acastus</horn>
			</li>
		</modExtensions>

		<vehicleStats>
			<Mass>9500</Mass>
			<MoveSpeed>3.4</MoveSpeed>
			<CargoCapacity>450</CargoCapacity>
			<RepairRate>0.9</RepairRate>
		</vehicleStats>

		<!-- Knight sounds (Tools/gen_knight_sounds.py): reactor hum loops while the engine runs, start-up / shut-down, hatch when the pilot climbs in or out. -->
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>LIK_Snd_hum_Acastus</value>
			</li>
		</soundSustainersOnEvent>
		<soundOneShotsOnEvent Inherit="False">
			<li>
				<key>PawnEntered</key>
				<value>LIK_Snd_hatch_in</value>
			</li>
			<li>
				<key>PawnExited</key>
				<value>LIK_Snd_hatch_out</value>
			</li>
			<li>
				<key>IgnitionOn</key>
				<value>LIK_Snd_startup_Acastus</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>LIK_Snd_shutdown_Acastus</value>
			</li>
		</soundOneShotsOnEvent>

		<statBases>
			<ArmorRating_Blunt>1.90</ArmorRating_Blunt>
			<ArmorRating_Sharp>2.10</ArmorRating_Sharp>
			<ArmorRating_Heat>1.0</ArmorRating_Heat>
			<Flammability>0.2</Flammability>
			<MarketValue>120000</MarketValue>
