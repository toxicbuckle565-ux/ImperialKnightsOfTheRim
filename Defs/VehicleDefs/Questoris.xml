	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>LIK_QuestorisBlueprint</defName>
		<label>Questoris Knight</label>
		<description>The line Knight of the great houses. A thermal cannon on one arm, a rapid-fire battle cannon on the other, and twin carapace heavy stubbers. Piloted from a throne in the carapace.</description>
		<graphicData>
			<texPath>Things/Knights/Questoris/Icon/questoris</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(10.000,10.000)</drawSize>
		</graphicData>
		<size>(6,6)</size>
		<statBases>
			<MaxHitPoints>4000</MaxHitPoints>
			<WorkToBuild>300000</WorkToBuild>
			<Flammability>0.1</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>LIK_QuestorisKnights</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>
		<costList>
			<Steel>2500</Steel>
			<Plasteel>700</Plasteel>
			<ComponentIndustrial>60</ComponentIndustrial>
			<ComponentSpacer>30</ComponentSpacer>
			<Gold>50</Gold>
		</costList>
		<designationCategory Inherit="False" />
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<soundBuilt/>
		<thingToSpawn>LIK_Questoris</thingToSpawn>
	</Vehicles.VehicleBuildDef>

