	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>LIK_CerastusBlueprint</defName>
		<label>Cerastus Knight</label>
		<description>A fast, specialised war machine of the Cerastus patterns (Acheron, Atrapos, Castigator, Lancer), each built around one signature weapon. Piloted by a single noble through the Throne Mechanicum.</description>
		<graphicData>
			<texPath>Things/Knights/Cerastus/Icon/cerastus</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(10.010,10.010)</drawSize>
		</graphicData>
		<size>(7,7)</size>
		<statBases>
			<MaxHitPoints>5500</MaxHitPoints>
			<WorkToBuild>420000</WorkToBuild>
			<Flammability>0.1</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>LIK_CerastusKnights</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>11</constructionSkillPrerequisite>
		<costList>
			<Steel>3200</Steel>
			<Plasteel>1000</Plasteel>
			<ComponentIndustrial>80</ComponentIndustrial>
			<ComponentSpacer>42</ComponentSpacer>
			<Gold>80</Gold>
		</costList>
		<designationCategory Inherit="False" />
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<soundBuilt/>
		<thingToSpawn>LIK_Cerastus</thingToSpawn>
	</Vehicles.VehicleBuildDef>

