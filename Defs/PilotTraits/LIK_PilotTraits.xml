<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--
		How a pilot's personality changes the toll of piloting a Knight. Multipliers (1 = no change, <1 = lessens the toll):
		  strain   = neural strain build-up
		  feedback = damage feedback through the neural link (machine-spirit wrath) and the shock when a part is destroyed
		  age      = ageing from piloting
		Several traits multiply together (never below x0.25). The mod setting "Personality" scales how much this matters
		(0 = ignore traits, 1 = as written, 2 = twice as strong). Vanilla traits only.
		Add your own with:  <LIK.PilotTraitModifierDef><defName>..</defName><trait>TraitDefName</trait><degree>0</degree>...
	-->

	<!-- toughness -->
	<LIK.PilotTraitModifierDef>
		<defName>LIK_Pilot_Tough</defName>
		<trait>Tough</trait>
		<degree>0</degree>
		<strain>0.85</strain>
		<feedback>0.7</feedback>
		<age>0.8</age>
	</LIK.PilotTraitModifierDef>
