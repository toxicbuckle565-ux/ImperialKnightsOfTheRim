<?xml version="1.0" encoding="utf-8"?>
<!--
  2026-11-22 (user: the plasma reactor said "Not connected to grav engine" and did not extend the build area): the vanilla grav engine only
  links to the facilities in its linkableFacilities list, so the reactor could never link (no support bonus, its footprint never counted).
-->
<Patch>
	<Operation Class="PatchOperationAdd">
		<!-- 2026-11-23: every grav engine, not just the vanilla one - Vanilla Gravship Expanded adds VGE_GravjumperEngine and VGE_GravhulkEngine
		     (thingClass Building_GravEngine); without this the reactor could not link to them -->
		<xpath>Defs/ThingDef[defName="GravEngine" or thingClass="Building_GravEngine"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
		<value>
			<li>IMP_PlasmaReactor</li>
		</value>
	</Operation>
</Patch>
