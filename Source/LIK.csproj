<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>LocalImperialKnights</AssemblyName>
    <RootNamespace>LIK</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <Workshop>C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/</Workshop>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <!-- 2026-11-23: game installs on 1.7 have no Managed/ folder; build against the 1.6 reference package. The same DLL runs on 1.6 and,
         through Waylith's UnityEngine->UnityStubs redirect, on 1.7 -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <Reference Include="0Harmony"><HintPath>$(Workshop)2009463077/1.6/Assemblies/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SmashTools"><HintPath>$(Workshop)3014915404/1.6/Assemblies/SmashTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vehicles"><HintPath>$(Workshop)3014915404/1.6/Assemblies/Vehicles.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
